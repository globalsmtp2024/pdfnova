ENVIRONMENT=development
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
COOKIE_SECURE=false

SECRET_KEY=replace-with-output-of-python-c-import-secrets-print-secrets.token_urlsafe-64
STORAGE_ENCRYPTION_KEY=replace-with-output-of-python-c-import-os-base64-print-base64.b64encode-os.urandom-32

POSTGRES_USER=pdfnova
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=pdfnova

S3_BUCKET=pdfnova
S3_ENDPOINT_URL=http://objectstore:8333
S3_SERVER_SIDE_ENCRYPTION=false
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pdfnova
S3_SECRET_ACCESS_KEY=replace-with-a-strong-secret-at-least-8-chars

EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@pdfnova.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SENTRY_DSN=
JOB_TIMEOUT_SECONDS=300
JOB_MEMORY_LIMIT_MB=2048
